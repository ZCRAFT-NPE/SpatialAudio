{
  "schemaVersion": 1,
  "id": "spatialaudio",
  "version": "${version}",
  "name": "SpatialAudio",
  "description": "A New Minecraft mod that provides realistic audio physics using parallel wave tracing and an improved physics algorithm.",
  "authors": ["Dr. Rubisco (@thedocruby), ZCRAFT"],
  "contact": {
    "sources": "https://github.com/thedocruby/resounding",
    "issues": "https://github.com/thedocruby/resounding/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/spatialaudio/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.thedocruby.resounding.ModClient"
    ],
    "server": [
      "dev.thedocruby.resounding.ModServer"
    ],
    "modmenu": [
      "dev.thedocruby.resounding.config.BlueTapePack.ModMenuIntegration"
    ],
    "voicechat": [
      "dev.thedocruby.resounding.compat.voicechat.Plugin"
    ]
  },
  "mixins": [
    "spatialaudio.mixins.json",
    "bluetapepack.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "cloth-config2": ">=6.2.57",
    "fabricloader": ">=0.13.3",
    "minecraft": ">=1.20"
  },
  "suggests": {
    "modmenu": ">=3.1.0",
    "voicechat": ">=1.18.2-2.2.39"
  }
}
